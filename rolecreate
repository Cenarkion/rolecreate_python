#!/usr/bin/env python3
import os
import requests
import argparse
import subprocess
import sys
import getpass

def parse_arguments():
    """Parses command-line arguments."""
    parser = argparse.ArgumentParser(description="Create a new Ansible role and push it to GitHub.")
    parser.add_argument("--name", "-n", type=str, dest="name", required=True, help="The name of the new role.")
    parser.add_argument("--private", "-p", dest="is_private", action="store_true", help="Create a private repository.")
    parser.add_argument("--repo-path", type=str, dest="repo_path", default=".", help="The path to the directory where the new role will be created.")
    parser.add_argument("--github-username", type=str, dest="github_username", help="The GitHub username.")
    return parser.parse_args()

def create_github_repo(repo_name, is_private, token):
    """Creates a new GitHub repository."""
    API_URL = "https://api.github.com"
    payload = f'{{"name": "{repo_name}", "private": {str(is_private).lower()}}}'
    headers = {
        "Authorization": f"token {token}",
        "Accept": "application/vnd.github.v3+json"
    }
    try:
        r = requests.post(f"{API_URL}/user/repos", data=payload, headers=headers)
        if r.status_code == 422:
            print(f"Error creating GitHub repository: A repository with the name '{repo_name}' already exists.")
            sys.exit(1)
        r.raise_for_status()
        print(f"Successfully created GitHub repository: {repo_name}")
    except requests.exceptions.RequestException as err:
        print(f"Error creating GitHub repository: {err}")
        sys.exit(1)

def create_ansible_role(repo_name, repo_path, github_username):
    """Creates a new Ansible role structure."""
    # Use absolute paths to avoid issues with chdir
    repo_path = os.path.abspath(repo_path)
    full_repo_path = os.path.join(repo_path, repo_name)
    roles_path = os.path.join(full_repo_path, "roles")
    
    try:
        os.makedirs(roles_path, exist_ok=True)
    except OSError as e:
        print(f"Error creating directory {roles_path}: {e}")
        sys.exit(1)

    try:
        # Run ansible-galaxy init in the roles_path
        subprocess.run(["ansible-galaxy", "init", repo_name], check=True, capture_output=True, text=True, cwd=roles_path)
        
        # Change to the new repo's directory for git operations
        os.chdir(full_repo_path)
        subprocess.run(["git", "init"], check=True, capture_output=True, text=True)
        subprocess.run(["git", "remote", "add", "origin", f"git@github.com:{github_username}/{repo_name}.git"], check=True, capture_output=True, text=True)
        
        # Now use absolute paths for moving files
        ansible_role_path = os.path.join(roles_path, repo_name)
        os.rename(os.path.join(ansible_role_path, "README.md"), os.path.join(full_repo_path, "README.md"))
        os.rename(os.path.join(ansible_role_path, "tests", "test.yml"), os.path.join(full_repo_path, f"{repo_name}.yml"))
        
        print(f"Successfully created Ansible role structure in: {full_repo_path}")

    except subprocess.CalledProcessError as err:
        print(f"Error creating Ansible role: Command '{err.cmd}' failed with exit code {err.returncode}.")
        print(f"Stderr: {err.stderr}")
        sys.exit(1)
    except FileNotFoundError as err:
        print(f"Error: {err}. Make sure 'ansible-galaxy' and 'git' are installed and in your PATH.")
        sys.exit(1)
    except OSError as e:
        print(f"Error moving files: {e}")
        sys.exit(1)

def push_to_github():
    """Pushes the new role to GitHub."""
    try:
        subprocess.run(["git", "add", "."], check=True, capture_output=True, text=True)
        subprocess.run(["git", "commit", "-m", "Initial Commit"], check=True, capture_output=True, text=True)
        subprocess.run(["git", "push", "origin", "master"], check=True, capture_output=True, text=True)
        print("Successfully pushed initial commit to GitHub.")
    except subprocess.CalledProcessError as err:
        print(f"Error pushing to GitHub: Command '{err.cmd}' failed with exit code {err.returncode}.")
        print(f"Stderr: {err.stderr}")
        sys.exit(1)
    except FileNotFoundError as err:
        print(f"Error: {err}. Make sure 'git' is installed and in your PATH.")
        sys.exit(1)

def main():
    """Main function."""
    args = parse_arguments()
    
    token = os.environ.get("GITHUB_TOKEN")
    if not token:
        try:
            token = getpass.getpass("GitHub token not found. Please enter your GitHub personal access token: ")
        except getpass.GetPassWarning:
            print("Could not read password securely.")
            token = input("GitHub token not found. Please enter your GitHub personal access token: ")

    if not token:
        print("GitHub token not provided. Please set the GITHUB_TOKEN environment variable or enter the token when prompted.")
        sys.exit(1)

    github_username = args.github_username
    if not github_username:
        try:
            github_username = subprocess.check_output(["git", "config", "user.name"]).strip().decode()
        except (subprocess.CalledProcessError, FileNotFoundError):
            print("GitHub username not provided and could not be found in git config. Please use the --github-username flag or set it in your git config (git config --global user.name <username>).")
            sys.exit(1)

    create_github_repo(args.name, args.is_private, token)
    create_ansible_role(args.name, args.repo_path, github_username)
    push_to_github()

if __name__ == "__main__":
    main()

